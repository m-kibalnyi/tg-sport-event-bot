# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL Database Settings (Neon.tech compatible)
# PAYMENTS_PAGE_URL=https://your-app-web.onrender.com/event.php
DB_HOST=DB_HOST
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASS=DB_PASS
DB_SSLMODE=require

# Optional: Payments Page URL (if you have one)
PAYMENTS_PAGE_URL=https://tg-sport-event-bot.onrender.com/event.php

# Optional: Telegraph Token (for automatic payment logs)
TELEGRAPH_TOKEN=
